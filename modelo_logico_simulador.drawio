        <mxCell id="n1" value="Modelo logico del simulador" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="10" width="400" height="30" as="geometry" /></mxCell><mxCell id="n2" value="INICIO de la corrida" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="160" height="50" as="geometry" /></mxCell><mxCell id="n3" value="n = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="210.0" width="200" height="44" as="geometry" /></mxCell><mxCell id="n4" value="n &lt;= N ? (cascadas a crear)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="280.0" width="240" height="90" as="geometry" /></mxCell><mxCell id="n5" value="Sortear instante de inicio de la cascada n" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="285.0" width="210" height="55" as="geometry" /></mxCell><mxCell id="n6" value="Sortear atributos del actor semilla (bootstrap)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="370.0" width="210" height="55" as="geometry" /></mxCell><mxCell id="n7" value="Crear nodo semilla n ; PROGRAMAR su 'Generacion y clasificacion' en la FEL compartida" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="455.0" width="250" height="60" as="geometry" /></mxCell><mxCell id="n8" value="n = n + 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="545.0" width="210" height="44" as="geometry" /></mxCell><mxCell id="n16" value="las N cascadas quedan cargadas en una sola FEL, compitiendo por los mismos moderadores" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="400.0" width="340" height="50" as="geometry" /></mxCell><mxCell id="n17" value="Drenar la FEL compartida" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="650.0" width="220" height="50" as="geometry" /></mxCell><mxCell id="n19" value="FEL vacia o K &gt;= KMAX ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="740.0" width="260" height="100" as="geometry" /></mxCell><mxCell id="n20" value="FIN" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="670.0" width="140" height="50" as="geometry" /></mxCell><mxCell id="n21" value="VR=(ALCANCE_NOC,COSTO) registrar VE" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="730.0" width="220" height="40" as="geometry" /></mxCell><mxCell id="n22" value="Extraer de la FEL el evento de menor tiempo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455" y="890.0" width="270" height="60" as="geometry" /></mxCell><mxCell id="n23" value="Tipo de evento extraido?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="1130.0" width="240" height="90" as="geometry" /></mxCell><mxCell id="n28" value="RAMA GENERADOR" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="1260.0" width="